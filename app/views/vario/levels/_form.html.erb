<% label     = nil if local_assigns[:label].blank? %>
<% context   = {} if local_assigns[:context].blank? %>
<% draggable = true if local_assigns[:draggable].nil? %>
<% condition_columns = { 12 => 'col-span-12', 6 => 'col-span-6', 4 => 'col-span-4', 3 => 'col-span-3' } %>

<%= form_with model: level, scope: :level, url: polymorphic_path([vario, setting, level]), id: "level_#{level.id}", builder: FormComponents::FormBuilder do |f| %>
  <% context.each do |key, value| %>
    <%= hidden_field_tag "level[context][#{key}]", value, id: nil %>
  <% end %>
  <% level.conditions_for(context).each do |condition| %>
    <%= hidden_field_tag "level[conditions][#{condition.key}]", context[condition.key.to_sym], id: nil %>
  <% end %>

  <div class="vario-level">
    <% if label %>
      <div class="vario-level__title"><%= label %></div>
    <% end %>
    <div class="col-span-1">
      <% if draggable %>
        <button type="button" class="vario-level__handle" data-vario--sortable-target="handle" aria-label="Move">
          <i class="fal fa-grip-lines"></i>
        </button>
      <% end %>
    </div>
    <div class="vario-level__conditions">
      <% conditions = level.conditions_not_for(context) %>
      <%= f.fields_for :conditions, level.condition_values do |ff| %>
        <% conditions.each do |condition| %>
          <div class="<%= condition_columns.fetch([12 / conditions.size, 3].max) %>">
            <% case condition.key_data[:type] %>
            <% when :select %>
              <%= ff.select condition.key, condition.collection, { include_blank: true, label: condition.key }, { id: "#{condition.key}_#{level.id}" } %>
            <% when :boolean %>
              <%= ff.check_box condition.key, switch: true, label: condition.key, id: "#{condition.key}_#{level.id}" %>
            <% else %>
              <%= ff.text_field condition.key, label: condition.key, id: "#{condition.key}_#{level.id}" %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="vario-level__value">
      <% case setting.type %>
      <% when :array %>
        <% if setting.collection.present? %>
          <%= f.select :value, [['All', 'all']] + setting.collection, {}, { multiple: true, id: "value_#{level.id}" } %>
        <% else %>
          <%= f.text_area :value, rows: 10, id: "value_#{level.id}", description: 'Multiple values possible, separate with "," or new lines.' %>
        <% end %>
      <% when :integer %>
        <%= f.number_field :value, id: "value_#{level.id}" %>
      <% when :boolean %>
        <%= f.check_box :value, switch: true, id: "value_#{level.id}", checked: setting.parse_value(level.value.nil? ? setting.default : level.value) %>
      <% when :text %>
        <%= f.code_editor :value, id: "value_#{level.id}" %>
      <% when :hash %>
        <%= f.code_editor :value, lang: :yaml, id: "value_#{level.id}" %>
      <% else %>
        <% if setting.collection.present? %>
          <%= f.select :value, setting.collection, { include_blank: true }, { id: "value_#{level.id}" } %>
        <% else %>
          <%= f.text_field :value, id: "value_#{level.id}" %>
        <% end %>
      <% end %>
    </div>

    <div class="vario-level__buttons">
      <%= button_tag t('.save'), name: 'commit', value: 'save', class: 'vario-button' %>
      <% unless label %>
        <%= button_tag t('.delete'), name: 'commit', value: 'delete', class: 'vario-button vario-button--danger' %>
      <% end %>
    </div>
  </div>
<% end %>
