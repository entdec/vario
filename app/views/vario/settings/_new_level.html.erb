<% context = {} if local_assigns[:context].blank? %>
<% level   = setting.new_level %>

<%= tag.div data: { id: "#{setting.id}_new_level" }, hidden: level.conditions_not_for(context).size.zero? && setting.levels.find { |level| level.with_context_values?(context) }.present? do %>
  <%= render partial: 'vario/levels/form', locals: { setting: setting, level: level, label: 'New level', context: context, draggable: false } %>
<% end %>
