<%= vario_card :"vario_settings #{@setting.title}", title: @setting.title, icon: 'fad fa-sliders' do |card| %>
  <% card.action do %>
    <%= link_to('Back', settings_path(settable: @setting.settable.to_sgid(for: 'Vario').to_s), class: 'vario-button') %>
  <% end %>

  <p class="vario-description">
    <% if @setting.default.present? %>
      <%= "#{@setting.description} (default: #{[*@setting.default].join(', ')})" %>
    <% else %>
      <%= @setting.description %>
    <% end %>
  </p>
  <%= render partial: 'vario/settings/levels', locals: { setting: @setting } %>
  <%= render partial: 'vario/settings/new_level', locals: { setting: @setting } %>
<% end %>
