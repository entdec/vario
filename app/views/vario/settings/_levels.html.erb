<% context = {} if local_assigns[:context].blank? %>

<div class="vario-levels" data-id="<%= setting.id %>_levels" data-controller="vario--sortable" data-error-message="An unexpected error occurred, your drop possibly failed.">
  <% setting.levels.each do |level| %>
    <%= tag.div data: { 'vario--sortable-target': 'item', url: vario.move_setting_level_path(setting_id: setting.id, id: level.id) }, hidden: !level.with_context_values?(context) do %>
      <%= render partial: 'vario/levels/form', locals: { setting: setting, level: level, context: context } %>
    <% end %>
  <% end %>
</div>
