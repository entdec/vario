<% ui_card_title = 'Settings' if local_assigns[:ui_card_title].blank? %>

<%= vario_card :"vario_settings #{ui_card_title}", title: ui_card_title, icon: 'fad fa-slider' do |card| %>
  <% settings_with_contexts.sort_by { |setting| setting[:setting].name }.each do |setting| %>
    <% card.tab setting[:setting].name, title: setting[:setting].title do %>
      <p class="vario-description"><%= setting[:setting].description %></p>
      <%= render partial: 'vario/settings/levels', locals: setting %>
      <%= render partial: 'vario/settings/new_level', locals: setting %>
    <% end %>
  <% end %>
<% end %>
