<%= vario_card :"vario_settings #{@title}", title: @title, icon: 'fad fa-sliders' do |card| %>
  <% @groups.each do |group| %>
    <% card.tab group[:name] do %>
      <%= render 'vario/settings/table', settings: @settings.for_group(group[:name]) %>
    <% end %>
  <% end %>

  <% if @settings.without_group.present? %>
    <% card.tab :ungrouped do %>
      <%= render 'vario/settings/table', settings: @settings.without_group %>
    <% end %>
  <% end %>
<% end %>
