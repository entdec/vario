<%# The settable's topics. Searched, the topics whose title matches and, under their topic, the settings whose label or description does, each a link to its section %>
<nav class="vario-topics__nav" aria-label="<%= t('vario.pages.nav.label') %>" data-controller="vario--search">
  <input type="search" class="vario-topics__search" placeholder="<%= t('vario.pages.nav.search') %>" aria-label="<%= t('vario.pages.nav.search') %>" data-action="input->vario--search#filter" data-vario--search-target="input">
  <ul class="vario-topics__list">
    <% topics.each do |topic| %>
      <li data-vario--search-target="topic" data-keywords="<%= topic.title %>">
        <%= link_to topic_path(topic.key), class: 'vario-topics__link', aria: { current: (topic == current ? 'page' : nil) } do %>
          <% if topic.topic.icon %><i class="<%= topic.topic.icon %> fa-fw" aria-hidden="true"></i><% end %>
          <span><%= topic.title %></span>
        <% end %>
        <ul class="vario-topics__settings">
          <% topic.topic.definitions.each_value do |definition| %>
            <li hidden data-vario--search-target="setting" data-keywords="<%= [definition.label, definition.description].compact.join(' ') %>">
              <%= link_to definition.label, topic_path(topic.key, anchor: "setting_#{definition.key}"), class: 'vario-topics__setting' %>
            </li>
          <% end %>
        </ul>
      </li>
    <% end %>
  </ul>
  <p class="vario-topics__none" hidden data-vario--search-target="none"><%= t('vario.pages.nav.none') %></p>
</nav>
