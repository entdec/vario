<div class="vario-topics">
  <%= render 'vario/topics/nav', topics: @topics, current: @topic %>

  <main class="vario-topic">
    <%= form_with url: topic_path(@topic.key, settable: params[:settable]), method: :patch, builder: FormComponents::FormBuilder,
                  data: { controller: 'vario--topic', action: 'input->vario--topic#changed change->vario--topic#changed' } do |form| %>
      <header class="vario-topic__head">
        <% if @topic.topic.icon %><i class="<%= @topic.topic.icon %> fa-fw vario-topic__icon" aria-hidden="true"></i><% end %>
        <div class="vario-topic__title">
          <h1><%= @topic.title %></h1>
          <% if @topic.topic.description %><p><%= @topic.topic.description %></p><% end %>
        </div>
        <div class="vario-topic__savebar" data-vario--topic-target="savebar">
          <span class="vario-topic__unsaved" hidden data-vario--topic-target="unsaved"><%= t('vario.pages.show.unsaved') %></span>
          <%= link_to t('vario.pages.show.cancel'), topic_path(@topic.key, settable: params[:settable]), class: 'vario-button', hidden: true, data: { 'vario--topic-target': 'cancel' } %>
          <%= form.submit t('vario.pages.show.save'), class: 'vario-button vario-button--primary' %>
        </div>
      </header>

      <div class="vario-topic__settings">
        <% @topic.topic.definitions.each_value do |definition| %>
          <%= render 'vario/topics/setting', form: form, definition: definition, setting: @settings[definition.key], settable: @settable %>
        <% end %>
      </div>
    <% end %>
  </main>
</div>
